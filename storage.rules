rules_version = '2';
// Project documents. Owner uploads (max 10 MB); members read. Replacements open files through the
// unguessable download link carried in their handoff, never through project membership.
service firebase.storage {
  match /b/{bucket}/o {
    function project(pid) { return firestore.get(/databases/(default)/documents/projects/$(pid)).data; }
    match /projects/{pid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid in project(pid).memberIds;
      allow write: if request.auth != null && project(pid).ownerId == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
